{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "AgroConnect",
  "version": "4.0.0",
  "identifier": "com.agroconnect.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "AgroConnect - Tauri Enterprise",
        "width": 1480,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
